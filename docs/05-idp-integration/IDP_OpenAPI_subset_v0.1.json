  "components": {
    "schemas": {
      "LoginDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CreateRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "separatorType": {
            "type": "string"
          },
          "separatorValue": {
            "type": "number"
          },
          "document": {
            "type": "string",
            "format": "binary"
          },
          "deleteFile": {
            "type": "string"
          },
          "requestGroupId": {
            "type": "string"
          },
          "extraParams": {
            "type": "object"
          }
        },
        "required": [
          "name",
          "templates",
          "document"
        ]
      },
      "CreateWorkflowRequestDTO": {
        "type": "object",
        "properties": {
          "ocrRequestIds": {
            "description": "List of OCR Requests that will be the inputs for workflow.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflowId": {
            "type": "string",
            "description": "The flow ID"
          },
          "name": {
            "type": "string",
            "description": "The Workflow Request Name"
          },
          "autoStart": {
            "type": "string",
            "description": "The Workflow Request Auto Start Flag"
          }
        },
        "required": [
          "ocrRequestIds",
          "workflowId",
          "name"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    }
  }
