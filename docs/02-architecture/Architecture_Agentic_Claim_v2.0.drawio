<diagram id="p1" name="02 · Góc nghiệp vụ — đường đi một hồ sơ"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Đường đi của một hồ sơ bồi thường — ai làm gì, lúc nào&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Đọc từ trái sang phải. Mỗi cột là một giai đoạn, mỗi hàng là một bên tham gia. Thời gian ghi ở đáy là số đo thật ngày 17/09/2026.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="2460" height="62" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;1. Tiếp nhận&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Khách nộp hồ sơ và chứng từ&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="5" value='&lt;b style="font-size:13px"&gt;2. Bóc tách&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Máy đọc chứng từ thành dữ liệu&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="612" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="6" value='&lt;b style="font-size:13px"&gt;3. Quyền lợi&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Chốt hợp đồng và biểu quyền lợi&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="924" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:13px"&gt;4. Đánh giá&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Máy đọc bệnh án, nêu nghi vấn&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1236" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="8" value='&lt;b style="font-size:13px"&gt;5. Tính tiền&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Chuỗi 13 bước tất định&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1548" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="9" value='&lt;b style="font-size:13px"&gt;6. Duyệt&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Người quyết định&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1860" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="10" value='&lt;b style="font-size:13px"&gt;7. Chi trả&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Lệnh chi và thông báo&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#F4F6F1;strokeColor=#9AA096;fontColor=#2A2E2A;fontSize=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2172" y="120" width="300" height="58" as="geometry"/></mxCell><mxCell id="11" value='&lt;b style="font-size:12px"&gt;Khách hàng&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EFEFEC;strokeColor=#7A7F79;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="230" height="140" as="geometry"/></mxCell><mxCell id="12" value='&lt;b style="font-size:12px"&gt;Nhân viên thẩm định&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EFEFEC;strokeColor=#7A7F79;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="230" height="140" as="geometry"/></mxCell><mxCell id="13" value='&lt;b style="font-size:12px"&gt;CLM_Core — tất định&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="230" height="140" as="geometry"/></mxCell><mxCell id="14" value='&lt;b style="font-size:12px"&gt;CLM_Agents — phán đoán&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="230" height="140" as="geometry"/></mxCell><mxCell id="15" value='&lt;b style="font-size:12px"&gt;BnK IDP&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="230" height="140" as="geometry"/></mxCell><mxCell id="16" value='&lt;b style="font-size:12px"&gt;InsureMO · Tài chính&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="940" width="230" height="140" as="geometry"/></mxCell><mxCell id="17" value='&lt;b style="font-size:11px"&gt;Khai và tải lên&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Số hợp đồng, người được&lt;br&gt;bảo hiểm, đợt điều trị&lt;br&gt;3–20 ảnh hoặc PDF&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="300" y="196" width="300" height="128" as="geometry"/></mxCell><mxCell id="18" value='&lt;b style="font-size:11px"&gt;Mở hồ sơ&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Sinh claimNo&lt;br&gt;Tạo request group&lt;br&gt;Trạng thái: TIẾP NHẬN&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="300" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="19" value='&lt;b style="font-size:11px"&gt;AG-1 Tiếp nhận&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đọc hồ sơ, kiểm danh mục&lt;br&gt;chứng từ có đủ chưa&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="300" y="646" width="300" height="128" as="geometry"/></mxCell><mxCell id="20" value='&lt;b style="font-size:11px"&gt;Nhận chứng từ&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;POST /request/group&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;POST /request&lt;/span&gt; × N&lt;br&gt;Trả requestId&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="300" y="796" width="300" height="128" as="geometry"/></mxCell><mxCell id="21" value='&lt;b style="font-size:11px"&gt;Chờ và gom&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Timer poll theo backoff&lt;br&gt;3→5→10→30 giây&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="612" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="22" value='&lt;b style="font-size:11px"&gt;Bóc tách&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Phân loại vào 1 trong 9&lt;br&gt;template, bóc field và&lt;br&gt;bảng chi phí 13 cột&lt;br&gt;&lt;b&gt;9/9 đúng, conf 70–90&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="612" y="796" width="300" height="128" as="geometry"/></mxCell><mxCell id="23" value='&lt;b style="font-size:11px"&gt;Đối chiếu nếu cần&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Console hiện ảnh cạnh số&lt;br&gt;máy đọc, sửa tay có ghi vết&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EFEFEC;strokeColor=#7A7F79;fontColor=#2A2E2A;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="924" y="346" width="300" height="128" as="geometry"/></mxCell><mxCell id="24" value='&lt;b style="font-size:11px"&gt;Chốt snapshot&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đọc quyền lợi &lt;b&gt;tại ngày&lt;/b&gt;&lt;br&gt;dịch vụ&lt;b&gt; rồi đóng băng.&lt;/b&gt;&lt;br&gt;Sau bước này không đọc lại.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="924" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="25" value='&lt;b style="font-size:11px"&gt;AG-2 Đối chiếu&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Khớp chứng từ với hợp&lt;br&gt;đồng, nêu chỗ không khớp&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="924" y="646" width="300" height="128" as="geometry"/></mxCell><mxCell id="26" value='&lt;b style="font-size:11px"&gt;Trả dữ kiện&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Thành viên, hợp đồng,&lt;br&gt;cây quyền lợi as-at-date&lt;br&gt;&lt;b&gt;Ta tự tính &lt;span style="font-family:monospace"&gt;covered&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="924" y="946" width="300" height="128" as="geometry"/></mxCell><mxCell id="27" value='&lt;b style="font-size:11px"&gt;Gửi ngữ cảnh&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Chỉ ICD, loại đợt, khoảng&lt;br&gt;tuổi, giới — &lt;b&gt;không gửi&lt;/b&gt;&lt;br&gt;thông tin cá nhân&lt;b&gt;&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1236" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="28" value='&lt;b style="font-size:11px"&gt;AG-3 Lâm sàng&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đọc kết quả flow, nêu&lt;br&gt;nghi vấn, xếp theo dòng&lt;br&gt;chi phí (IDP chưa làm)&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1236" y="646" width="300" height="128" as="geometry"/></mxCell><mxCell id="29" value='&lt;b style="font-size:11px"&gt;Flow đánh giá&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;PUT /workflow/request&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;run-workflow-request&lt;/span&gt;&lt;br&gt;poll → &lt;span style="font-family:monospace"&gt;/result/json&lt;/span&gt;&lt;br&gt;&lt;b&gt;20 mục · 118 giây&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1236" y="796" width="300" height="128" as="geometry"/></mxCell><mxCell id="30" value='&lt;b style="font-size:11px"&gt;Chuỗi 13 bước&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Từng dòng chi phí: loại trừ →&lt;br&gt;thời gian chờ → trần theo đợt →&lt;br&gt;đồng chi trả → trần năm&lt;br&gt;&lt;b&gt;Chỉ ở đây mới ra tiền&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1548" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="31" value='&lt;b style="font-size:11px"&gt;AG-4 Danh mục&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Tra bệnh viện thật từ bảng&lt;br&gt;322 — &lt;b&gt;không lấy mã mà&lt;/b&gt;&lt;br&gt;flow trả về&lt;b&gt;&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1548" y="646" width="300" height="128" as="geometry"/></mxCell><mxCell id="32" value='&lt;b style="font-size:11px"&gt;Tra danh mục&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;/metadata/opensearch/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;table/322/search&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1548" y="796" width="300" height="128" as="geometry"/></mxCell><mxCell id="33" value='&lt;b style="font-size:11px"&gt;Quyết định&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Xem bảng tiền từng dòng,&lt;br&gt;xem vết agent, duyệt hoặc&lt;br&gt;từ chối hoặc yêu cầu bổ sung&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EFEFEC;strokeColor=#7A7F79;fontColor=#2A2E2A;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1860" y="346" width="300" height="128" as="geometry"/></mxCell><mxCell id="34" value='&lt;b style="font-size:11px"&gt;Ghi sổ hạn mức&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Trừ hạn mức năm, đợt, ngày.&lt;br&gt;Append-only, không sửa.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1860" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="35" value='&lt;b style="font-size:11px"&gt;AG-5 Soạn thảo&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Viết giải trình cho khách&lt;br&gt;bằng ngôn ngữ dễ hiểu&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1860" y="646" width="300" height="128" as="geometry"/></mxCell><mxCell id="36" value='&lt;b style="font-size:11px"&gt;Nhận kết quả&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Xem số tiền được chi và&lt;br&gt;lý do từng dòng bị trừ&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="2172" y="196" width="300" height="128" as="geometry"/></mxCell><mxCell id="37" value='&lt;b style="font-size:11px"&gt;Lệnh chi&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Sinh lệnh chi, chờ xác nhận&lt;br&gt;đã chi, đóng hồ sơ&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="2172" y="496" width="300" height="128" as="geometry"/></mxCell><mxCell id="38" value='&lt;b style="font-size:11px"&gt;Tài chính&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;I-11 lệnh chi · I-12 xác nhận&lt;br&gt;&lt;b&gt;Stub trong hackathon&lt;/b&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D7EAD4;strokeColor=#6FA463;fontColor=#1F3D1A;fontSize=9.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2172" y="946" width="300" height="128" as="geometry"/></mxCell><mxCell id="39" value='&lt;b style="font-size:12px"&gt;&amp;lt; 1 giây&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="40" value='&lt;b style="font-size:12px"&gt;~65 giây / 9 trang&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=11;" vertex="1" parent="1"><mxGeometry x="612" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="41" value='&lt;b style="font-size:12px"&gt;&amp;lt; 2 giây (mock)&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="924" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="42" value='&lt;b style="font-size:12px"&gt;118 giây&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1236" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="43" value='&lt;b style="font-size:12px"&gt;&amp;lt; 1 giây&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1548" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="44" value='&lt;b style="font-size:12px"&gt;người quyết định&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="45" value='&lt;b style="font-size:12px"&gt;ngoài phạm vi&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2172" y="1094" width="300" height="46" as="geometry"/></mxCell><mxCell id="46" value='&lt;b style="font-size:12px"&gt;Thời gian máy&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="1094" width="230" height="46" as="geometry"/></mxCell><mxCell id="47" value='&lt;b style="font-size:13px"&gt;Ba điều người nghiệp vụ cần nhớ&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;1.&lt;/b&gt; Máy không bao giờ tự quyết số tiền — nó chuẩn bị, con người bấm duyệt.   &lt;b&gt;2.&lt;/b&gt; Quyền lợi được chốt một lần tại ngày dịch vụ rồi đóng băng, nên kết quả hôm nay và tháng sau vẫn giống nhau.   &lt;b&gt;3.&lt;/b&gt; Mỗi con số trên màn hình đều truy ngược được về dòng chứng từ và điều khoản đã áp.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="1160" width="2460" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="03 · Góc kỹ thuật — lớp và module"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Các lớp kỹ thuật và ranh giới giữa chúng&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Dành cho đội dev và SA OutSystems. Mũi tên chỉ chiều phụ thuộc: lớp trên gọi lớp dưới, không có chiều ngược lại.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="2100" height="62" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;LỚP 1 · GIAO DIỆN&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Reactive Web. Không chứa logic nghiệp vụ, không gọi hệ ngoài.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBFBF9;strokeColor=#8A8F88;fontColor=#2A2E2A;fontSize=10;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="2080" height="190" as="geometry"/></mxCell><mxCell id="5" value='&lt;b style="font-size:13px"&gt;CLM_Portal&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Màn hình khách hàng: nộp hồ sơ, tải chứng từ, theo dõi, bổ sung.&lt;br&gt;Chỉ gọi Server Action public của CLM_Core.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="165" width="660" height="120" as="geometry"/></mxCell><mxCell id="6" value='&lt;b style="font-size:13px"&gt;CLM_Console&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Màn hình thẩm định: hàng đợi, đối chiếu ảnh ↔ số, sửa tay có vết,&lt;br&gt;bảng tiền theo dòng, duyệt, nhật ký agent.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="165" width="660" height="120" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:13px"&gt;Màn hình quản trị&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Ánh xạ biểu quyền lợi khi ra sản phẩm, nạp hợp đồng nhóm,&lt;br&gt;cấu hình template và bộ chứng từ.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1450" y="165" width="620" height="120" as="geometry"/></mxCell><mxCell id="8" value='&lt;b style="font-size:13px"&gt;LỚP 2 · NGHIỆP VỤ TẤT ĐỊNH — CLM_Core&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Nơi duy nhất sinh ra số tiền. Không có LLM. Mọi kết quả tái lập được.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBFBF9;strokeColor=#8A8F88;fontColor=#2A2E2A;fontSize=10;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="2080" height="290" as="geometry"/></mxCell><mxCell id="9" value='&lt;b style="font-size:13px"&gt;Chuỗi tính tiền&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;13 bước theo từng dòng chi phí:&lt;br&gt;· loại trừ hợp đồng&lt;br&gt;· thời gian chờ theo nhóm bệnh&lt;br&gt;· trần theo ngày / theo đợt&lt;br&gt;· tỷ lệ đồng chi trả (kế thừa cây)&lt;br&gt;· trần năm còn lại&lt;br&gt;Kết quả: số tiền + lý do từng dòng&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=10;" vertex="1" parent="1"><mxGeometry x="90" y="390" width="500" height="215" as="geometry"/></mxCell><mxCell id="10" value='&lt;b style="font-size:13px"&gt;Snapshot quyền lợi&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Đọc &lt;b&gt;một lần&lt;/b&gt; tại ngày dịch vụ rồi&lt;br&gt;đóng băng (quy tắc P-02).&lt;br&gt;&lt;br&gt;Ngoại lệ duy nhất được đọc lại:&lt;br&gt;&lt;span style="font-family:monospace"&gt;continuousCoverFrom&lt;/span&gt; khi tái tục,&lt;br&gt;và phải ghi vết trước/sau.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="390" width="480" height="215" as="geometry"/></mxCell><mxCell id="11" value='&lt;b style="font-size:13px"&gt;Sổ hạn mức&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Append-only. Không sửa, không xoá.&lt;br&gt;&lt;br&gt;· hạn mức năm đã dùng&lt;br&gt;· trần theo đợt điều trị&lt;br&gt;· trần theo ngày&lt;br&gt;Ghi khi duyệt, không ghi khi tính thử.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1110" y="390" width="460" height="215" as="geometry"/></mxCell><mxCell id="12" value='&lt;b style="font-size:13px"&gt;Máy trạng thái + vết&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Trạng thái hồ sơ và quyền chuyển.&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;AgentRun&lt;/span&gt; append-only: mỗi lượt gọi&lt;br&gt;agent, mỗi hand-off, mỗi lần người&lt;br&gt;sửa tay đều có dòng riêng.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1590" y="390" width="480" height="215" as="geometry"/></mxCell><mxCell id="13" value='&lt;b style="font-size:13px"&gt;LỚP 3 · PHÁN ĐOÁN — CLM_Agents (Agent Workbench)&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Agent đọc và đề xuất. Không agent nào được ghi tiền hay gọi thẳng hệ ngoài.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBFBF9;strokeColor=#8A8F88;fontColor=#2A2E2A;fontSize=10;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="2080" height="290" as="geometry"/></mxCell><mxCell id="14" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-0&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Điều phối&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Chia việc cho 5 agent còn lại, gom kết quả.&lt;br&gt;Có đường lui: Server Action OrchestrateClaim + hàng đợi + Timer nếu agent-to-agent không dùng được.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="90" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="15" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-1&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Tiếp nhận&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đọc hồ sơ và danh mục chứng từ, chỉ ra thiếu gì, sinh yêu cầu bổ sung.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="422" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="16" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-2&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Đối chiếu&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Khớp chứng từ với hợp đồng và biểu quyền lợi, nêu chỗ không khớp.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="754" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="17" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-3&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Lâm sàng&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đọc 20 mục từ flow IDP, xếp nghi vấn theo dòng chi phí — việc IDP chưa làm.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1086" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="18" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-4&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Danh mục&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Tra bệnh viện và mã thủ thuật từ bảng master, không tin giá trị flow trả.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1418" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="19" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;AG-5&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Soạn thảo&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Viết giải trình gửi khách bằng ngôn ngữ dễ hiểu, không sáng tạo con số.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1750" y="712" width="318" height="210" as="geometry"/></mxCell><mxCell id="20" value='&lt;b style="font-size:13px"&gt;LỚP 4 · TÍCH HỢP&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Mỗi hệ ngoài một module. Adapter hấp thụ mọi thói xấu để ba lớp trên không phải biết.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBFBF9;strokeColor=#8A8F88;fontColor=#2A2E2A;fontSize=10;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="2080" height="270" as="geometry"/></mxCell><mxCell id="21" value='&lt;b style="font-size:13px"&gt;CLM_IDP_Int → BnK IDP&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;IdpSession&lt;/span&gt; giữ token · thêm User-Agent bắt buộc&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpSubmitPackage&lt;/span&gt; nộp chứng từ (templates là &lt;b&gt;chuỗi CSV&lt;/b&gt;)&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpPoller&lt;/span&gt; Timer, backoff 3→5→10→30 s, trần 15 phút&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpGetExtractionResult&lt;/span&gt; copy nguyên &lt;span style="font-family:monospace"&gt;RawExtractionJson&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpStartClinicalAssessment&lt;/span&gt; + retry 3×5 s cho lệnh kích hoạt&lt;br&gt;&lt;b&gt;13 bẫy đã ghi lại&lt;/b&gt; trong Sổ tay API — adapter chặn từng cái&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="90" y="1040" width="660" height="180" as="geometry"/></mxCell><mxCell id="22" value='&lt;b style="font-size:13px"&gt;CLM_Core_Mock → InsureMO&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Facade của ta, schema vendor chưa ai thấy.&lt;br&gt;&lt;span style="font-family:monospace"&gt;GetMemberCoverage&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;GetBenefitTree&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;GetPolicy&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;SearchMembers&lt;/span&gt;&lt;br&gt;&lt;br&gt;Hackathon: đọc từ seed trong ODC.&lt;br&gt;Bật hệ thật bằng Site Setting &lt;span style="font-family:monospace"&gt;InsureMOMode&lt;/span&gt; — &lt;b&gt;chữ ký không đổi&lt;/b&gt;.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="770" y="1040" width="660" height="180" as="geometry"/></mxCell><mxCell id="23" value='&lt;b style="font-size:13px"&gt;Lớp tài chính&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;CreatePaymentInstruction&lt;/span&gt; (I-11)&lt;br&gt;&lt;span style="font-family:monospace"&gt;ConfirmPaymentSettled&lt;/span&gt; (I-12)&lt;br&gt;&lt;br&gt;Stub trong hackathon — sinh lệnh, không chuyển tiền.&lt;br&gt;Cổng phát hành trước lệnh chi thật còn chờ phòng Tài chính.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=9.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1450" y="1040" width="620" height="180" as="geometry"/></mxCell><mxCell id="24" value='&lt;b style="font-size:13px"&gt;Quy tắc phụ thuộc — thứ giữ cho hệ thống không rối&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Lớp 1 không gọi lớp 4.&lt;/b&gt; Giao diện chỉ gọi CLM_Core; muốn dữ liệu ngoài thì Core đi lấy.&lt;br&gt;&lt;b&gt;Lớp 3 không gọi lớp 4 trực tiếp.&lt;/b&gt; Agent gọi tool, tool là Server Action của Core, Core mới gọi adapter. Nhờ vậy mọi lời gọi ra ngoài đều có vết và đều chặn được.&lt;br&gt;&lt;b&gt;Lớp 4 không biết gì về nghiệp vụ.&lt;/b&gt; Adapter chỉ dịch định dạng và chịu lỗi; nó không biết thế nào là một hồ sơ hợp lệ.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="2080" height="120" as="geometry"/></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="320"/><mxPoint x="340" y="320"/></Array></mxGeometry></mxCell><mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="12" target="14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="660"/><mxPoint x="249" y="660"/></Array></mxGeometry></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="14" target="21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="p3" name="04 · Tích hợp BnK IDP"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Tích hợp BnK IDP — mang đi họp với đội IDP&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Mọi con số trên trang này là &lt;b&gt;đo thật&lt;/b&gt; trên tenant 177 ngày 17/09/2026, không phải ước lượng. Ô đỏ là việc cần đội IDP trả lời.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="2500" height="66" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;Môi trường đang dùng&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Base URL &lt;span style="font-family:monospace"&gt;idp-api.idpstg.bnksolution.com&lt;/span&gt;&lt;br&gt;Tenant &lt;b&gt;177 "Phòng 2"&lt;/b&gt; · user 204 vai Tenant (roleId 2)&lt;br&gt;Partner &lt;b&gt;40&lt;/b&gt; (payload trả về &lt;span style="font-family:monospace"&gt;refPartnerId "78"&lt;/span&gt;)&lt;br&gt;Hạn dùng tenant: &lt;b&gt;31/10/2026&lt;/b&gt;&lt;br&gt;Quota: &lt;span style="font-family:monospace"&gt;blockLimit 1&lt;/span&gt;, đã dùng &lt;b&gt;14 trang&lt;/b&gt;&lt;br&gt;&lt;br&gt;Header bắt buộc mọi lời gọi:&lt;br&gt;&lt;span style="font-family:monospace"&gt;Authorization: Bearer &amp;lt;jwt&amp;gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;User-Agent: Mozilla/5.0 …&lt;/span&gt; — thiếu là Cloudflare chặn 403/1010&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="620" height="210" as="geometry"/></mxCell><mxCell id="5" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 1&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Đăng nhập&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;POST /auth/login&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;356 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không có refresh token.&lt;br&gt;Cache trong &lt;span style="font-family:monospace"&gt;IdpSession&lt;/span&gt;.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="6" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 2&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Mở nhóm&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;POST /request/group&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;111 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 hồ sơ = 1 group.&lt;br&gt;Poll một lần cho cả nhóm.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1026" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="7" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 3&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Nộp chứng từ&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;POST /request&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;682 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;templates&lt;/span&gt; là &lt;b&gt;chuỗi CSV&lt;/b&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;"6090,6091,…,6098"&lt;/span&gt;&lt;br&gt;Mảng → 400 NaN.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1332" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="8" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 4&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Chờ bóc tách&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /request/group/{id}/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;check-status&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;15 s/trang&lt;/b&gt;&lt;br&gt;&lt;b&gt;65 s / 9 trang&lt;/b&gt;&lt;br&gt;&lt;br&gt;Backoff 3→5→10→30 s.&lt;br&gt;Trần 15 phút → operator.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1638" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="9" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 5&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Đọc kết quả&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /request/{id}/result&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;98 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dòng bảng ở khoá &lt;b&gt;&lt;span style="font-family:monospace"&gt;data&lt;/span&gt;&lt;/b&gt;,&lt;br&gt;không phải &lt;span style="font-family:monospace"&gt;rows&lt;/span&gt;.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1944" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="10" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 6&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Giữ bản gốc&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /request/{id}/raw-file&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;170 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trả &lt;b&gt;ZIP&lt;/b&gt;, không phải ảnh.&lt;br&gt;Gọi ngay, MinIO có thể dọn.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="2250" y="110" width="292" height="210" as="geometry"/></mxCell><mxCell id="11" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 7&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Mở phiên đánh giá&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;PUT /workflow/request&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;152 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;autoStart&lt;/span&gt; &lt;b&gt;vô tác dụng&lt;/b&gt;.&lt;br&gt;Nhận cả request đang Failed&lt;br&gt;→ ta phải tự kiểm.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="12" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 8&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Kích hoạt&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /workflow/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;run-workflow-request/{id}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;580 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bắt buộc gọi.&lt;br&gt;&lt;b&gt;Retry 3×5 s&lt;/b&gt; — ngoại lệ&lt;br&gt;4xx-retry duy nhất.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1026" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="13" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 9&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Chờ đánh giá&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /workflow/request/{id}&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;72 s (1 ct)&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;/b&gt;118 s (9 ct)&lt;b&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không ổn định:&lt;br&gt;30 s (03/09) → 72 s (17/09).&lt;br&gt;Trần poll ≥ 3 phút.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1332" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="14" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 10&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Đọc 20 mục&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /workflow/request/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;{id}/result/json&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;85 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;{}&lt;/span&gt; + HTTP 200 = flow &lt;b&gt;hỏng&lt;/b&gt;,&lt;br&gt;không bao giờ nghĩa là "sạch".&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1638" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="15" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 11&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Tra danh mục&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /metadata/opensearch/&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;table/322/search&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;180 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;13.328 cơ sở KCB.&lt;br&gt;Chọn theo score, xử lý trùng.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1944" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="16" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;BƯỚC 12&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Cấu hình&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;POST · PUT /template&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;POST /template/document-set&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;~900 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;9 template 6090–6098,&lt;br&gt;bộ chứng từ &lt;b&gt;198&lt;/b&gt;.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="2250" y="350" width="292" height="210" as="geometry"/></mxCell><mxCell id="17" value='&lt;b style="font-size:13px"&gt;Phía ta hấp thụ những gì&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;CLM_IDP_Int&lt;/span&gt; chặn 13 bẫy đã ghi lại, trong đó nặng nhất:&lt;br&gt;· &lt;span style="font-family:monospace"&gt;templates_data&lt;/span&gt; rỗng + &lt;span style="font-family:monospace"&gt;errorCode&lt;/span&gt; null = &lt;b&gt;lỗi cấu hình&lt;/b&gt;&lt;br&gt;· dòng bảng ở khoá &lt;span style="font-family:monospace"&gt;data&lt;/span&gt; — đọc &lt;span style="font-family:monospace"&gt;rows&lt;/span&gt; sẽ thấy bảng trống mà không có lỗi&lt;br&gt;· HTTP 200 vẫn có thể là lỗi — luôn đọc &lt;span style="font-family:monospace"&gt;errorCode&lt;/span&gt;/&lt;span style="font-family:monospace"&gt;statusCode&lt;/span&gt;&lt;br&gt;· &lt;span style="font-family:monospace"&gt;HospitalCode&lt;/span&gt;/&lt;span style="font-family:monospace"&gt;PlaceOfTreatment&lt;/span&gt;/&lt;span style="font-family:monospace"&gt;SurgeryCodes&lt;/span&gt; từ flow &lt;b&gt;không dùng&lt;/b&gt;&lt;br&gt;· chuẩn hoá &lt;span style="font-family:monospace"&gt;""&lt;/span&gt; &lt;span style="font-family:monospace"&gt;"None"&lt;/span&gt; &lt;span style="font-family:monospace"&gt;"null"&lt;/span&gt; &lt;span style="font-family:monospace"&gt;"00000"&lt;/span&gt; → null&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="620" height="210" as="geometry"/></mxCell><mxCell id="18" value='&lt;b style="font-size:13px"&gt;IDP làm được — đã kiểm bằng dữ liệu thật&lt;/b&gt;&lt;table style="font-size:10.5px;border-collapse:collapse;width:100%;margin-top:4px"&gt;&lt;tr&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Việc&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Bằng chứng đo được&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Phân loại chứng từ&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;9 ảnh nộp kèm cả 9 template → &lt;b&gt;9/9 đúng&lt;/b&gt;, confidence 70,4 – 90,5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Bóc field và bảng&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Bảng kê 13 cột đủ 5 dòng; tiền về &lt;b&gt;đủ chữ số&lt;/b&gt; (150000, 4500000, 1500)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Đối chiếu chéo chứng từ&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Trộn 1 chứng từ của bệnh nhân khác → flow bắt đúng &lt;b&gt;4/4&lt;/b&gt; điểm lệch: ngày vào viện, ngày ra viện, giấy tờ tuỳ thân, mã ICD&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Tra danh mục cơ sở KCB&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;OpenSearch bảng 322, 13.328 dòng, tìm theo tên có score&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1240" height="250" as="geometry"/></mxCell><mxCell id="19" value='&lt;b style="font-size:13px"&gt;IDP không làm — ta phải tự lo&lt;/b&gt;&lt;table style="font-size:10.5px;border-collapse:collapse;width:100%;margin-top:4px"&gt;&lt;tr&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Việc&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Hệ quả cho thiết kế&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Không tính tiền&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Không mục nào trong 20 mục nói về số tiền. Toàn bộ chuỗi tính tiền nằm ở CLM_Core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Không đánh giá theo dòng&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Không có &lt;span style="font-family:monospace"&gt;linesAssessed[]&lt;/span&gt;, &lt;span style="font-family:monospace"&gt;proposedReasonCode&lt;/span&gt;, &lt;span style="font-family:monospace"&gt;evidence[]&lt;/span&gt; → AG-3 phải lấp, Track 2 trình bày là chế độ tư vấn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Không có webhook&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-08 không tồn tại → ta poll bằng Timer và phát sự kiện nội bộ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Master data không đáng tin&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;span style="font-family:monospace"&gt;HospitalCode&lt;/span&gt; lúc trả &lt;span style="font-family:monospace"&gt;00000&lt;/span&gt;, lúc &lt;b&gt;bịa&lt;/b&gt; &lt;span style="font-family:monospace"&gt;01001&lt;/span&gt; (dòng đầu bảng 322)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1330" y="600" width="1220" height="250" as="geometry"/></mxCell><mxCell id="20" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;CHẶN · ĐỀ NGHỊ 1&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;Trần trang của một block là bao nhiêu?&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Đã dùng 14/1 block. Demo 3 hồ sơ × 9 chứng từ = 27 trang.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Con số trần + nâng quota tenant 177 tới 31/10&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="890" width="810" height="158" as="geometry"/></mxCell><mxCell id="21" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;CHẶN · ĐỀ NGHỊ 2&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;Ghim flow 5ed8e4fc suốt sprint&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Nội dung trả về đã đổi giữa 03/09 và 17/09 dù cùng workflowId.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Cam kết ghim; sửa flow thì bump workflowId&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10;" vertex="1" parent="1"><mxGeometry x="890" y="890" width="810" height="158" as="geometry"/></mxCell><mxCell id="22" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;CAO · ĐỀ NGHỊ 3&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;Ba trường master data trả giá trị giữ chỗ&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Chứng từ ghi rõ tên bệnh viện, flow vẫn trả 00000 và "null".&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Không tra được thì trả null nhất quán, đừng trả dòng đầu bảng&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1730" y="890" width="810" height="158" as="geometry"/></mxCell><mxCell id="23" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;CAO · ĐỀ NGHỊ 4&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;I-16 cần đánh giá theo dòng chi phí&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Hiện là 20 khối văn bản cho cả hồ sơ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Bổ sung linesAssessed[], proposedReasonCode, evidence[]&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1065" width="810" height="158" as="geometry"/></mxCell><mxCell id="24" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;CAO · ĐỀ NGHỊ 5&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;warning_level trộn hai loại ý nghĩa&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;"Ngày vào viện lệch" và "Danh mục bệnh viện" cùng mức 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Tách mức nghiêm trọng khỏi mục thông tin, hoặc xác nhận ý nghĩa&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10;" vertex="1" parent="1"><mxGeometry x="890" y="1065" width="810" height="158" as="geometry"/></mxCell><mxCell id="25" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;VỪA · ĐỀ NGHỊ 6&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12.5px"&gt;Bốn việc nhỏ hơn&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;mbal/template-map cho 6090–6098 · TTL token, MAX_FILE_SIZE, rate limit · POST /request/from-url đang 400 · hướng dẫn PDF nhiều trang&lt;br&gt;&lt;br&gt;&lt;b&gt;Đề nghị:&lt;/b&gt; Xác nhận hoặc lịch sửa&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1730" y="1065" width="810" height="158" as="geometry"/></mxCell><mxCell id="26" value='&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Chi tiết từng lời gọi, phản hồi thật và 13 bẫy: file &lt;span style="font-family:monospace"&gt;So-tay-API-BnK-IDP.html&lt;/span&gt; trong 00. Deliverables.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1250" width="2500" height="34" as="geometry"/></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="14" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="37" value="sau khi cả nhóm Completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2320" y="335"/><mxPoint x="866" y="335"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="p4" name="05 · Tích hợp InsureMO / phòng Core"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Tích hợp InsureMO — mang đi họp với phòng Core&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Toàn bộ đường dẫn dưới đây là &lt;b&gt;facade của adapter phía ta&lt;/b&gt;. Schema thật của InsureMO chưa ai thấy, nên mọi giao diện I-0x còn ở trạng thái tạm và trong hackathon chạy bằng mock seed trong ODC.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="2300" height="66" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;Ranh giới sở hữu dữ liệu — điều cần chốt trước tiên&lt;/b&gt;&lt;table style="font-size:10.5px;border-collapse:collapse;width:100%;margin-top:4px"&gt;&lt;tr&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;InsureMO làm chủ&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;BnK (chúng ta) làm chủ&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Sản phẩm, plan&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Hồ sơ bồi thường (claim)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Dòng quyền lợi, thời gian chờ&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Sổ hạn mức đã dùng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Hợp đồng, kỳ hiệu lực, trạng thái&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Tài khoản chi trả&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Mức quyền lợi (benefit level)&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Người thụ hưởng, người yêu cầu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Thành viên được bảo hiểm&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Toàn bộ vết thẩm định và quyết định&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="1140" height="300" as="geometry"/></mxCell><mxCell id="5" value='&lt;b style="font-size:13px"&gt;Ba quy tắc phía ta áp tại biên&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;1 · Ta tự tính &lt;span style="font-family:monospace"&gt;covered&lt;/span&gt;, không lấy phán quyết của vendor.&lt;/b&gt;&lt;br&gt;Ba phép so: ngày dịch vụ nằm trong kỳ hợp đồng · nằm trong kỳ hiệu lực của&lt;br&gt;thành viên · trạng thái hợp đồng là ACTIVE. Vendor trả &lt;span style="font-family:monospace"&gt;isCovered&lt;/span&gt; thì bỏ.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · Snapshot một lần rồi đóng băng (P-02).&lt;/b&gt;&lt;br&gt;Đọc quyền lợi tại ngày dịch vụ lúc đăng ký hồ sơ. Sau đó không đọc lại,&lt;br&gt;trừ đúng một ngoại lệ: &lt;span style="font-family:monospace"&gt;continuousCoverFrom&lt;/span&gt; khi tái tục, và phải ghi vết.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Thiếu thuộc tính là lỗi, không phải mặc định.&lt;/b&gt;&lt;br&gt;Vắng trên node con = kế thừa; vắng trên node gốc = lỗi biểu quyền lợi.&lt;br&gt;&lt;span style="font-family:monospace"&gt;coPaymentBp: "INHERIT"&lt;/span&gt; phải resolve được tới tổ tiên, không thì dừng hồ sơ.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DAE8FC;strokeColor=#5B82B0;fontColor=#12334F;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="1120" height="300" as="geometry"/></mxCell><mxCell id="6" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-05&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Tìm thành viên được bảo hiểm&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /v1/members&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="700" height="152" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:11px"&gt;Quy tắc adapter&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Ít nhất 1 tham số. &lt;span style="font-family:monospace"&gt;cardNo&lt;/span&gt; là khoá tiếp nhận (trẻ em chưa có CCCD).&lt;br&gt;&amp;gt;50 kết quả → 422 TOO_BROAD, không cắt bớt.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="790" y="440" width="780" height="152" as="geometry"/></mxCell><mxCell id="8" value='&lt;b style="font-size:11px"&gt;Câu hỏi cho phòng Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Vendor search có bỏ dấu tiếng Việt không?&lt;br&gt;Có lọc theo trạng thái thành viên không? (phải là KHÔNG)&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1610" y="440" width="740" height="152" as="geometry"/></mxCell><mxCell id="9" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-05&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Chi tiết hợp đồng&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /v1/policies/{policyNo}&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="50" y="608" width="700" height="152" as="geometry"/></mxCell><mxCell id="10" value='&lt;b style="font-size:11px"&gt;Quy tắc adapter&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Trạng thái &lt;b&gt;chỉ 2 giá trị&lt;/b&gt;: ACTIVE | CANCELLED.&lt;br&gt;Hết hạn không phải là trạng thái — suy từ kỳ hiệu lực.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="790" y="608" width="780" height="152" as="geometry"/></mxCell><mxCell id="11" value='&lt;b style="font-size:11px"&gt;Câu hỏi cho phòng Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Vòng đời trạng thái bên vendor rộng hơn → cần bảng ánh xạ ghim lại.&lt;br&gt;Giá trị chưa ánh xạ = lỗi tại biên, không đoán.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1610" y="608" width="740" height="152" as="geometry"/></mxCell><mxCell id="12" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-05&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Coverage tại ngày dịch vụ — phép đọc suy dẫn duy nhất&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /v1/members/{id}/coverage?asOfDate=&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="50" y="776" width="700" height="152" as="geometry"/></mxCell><mxCell id="13" value='&lt;b style="font-size:11px"&gt;Quy tắc adapter&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Trả về dữ kiện thô + &lt;span style="font-family:monospace"&gt;reasons[]&lt;/span&gt;. &lt;span style="font-family:monospace"&gt;continuousCoverFrom&lt;/span&gt; là &lt;b&gt;NGÀY&lt;/b&gt;, không phải cờ;&lt;br&gt;vắng thuộc tính này = lỗi schema, dừng hồ sơ (fail closed).&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="790" y="776" width="780" height="152" as="geometry"/></mxCell><mxCell id="14" value='&lt;b style="font-size:11px"&gt;Câu hỏi cho phòng Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;X-15&lt;/b&gt; &lt;span style="font-family:monospace"&gt;continuousCoverFrom&lt;/span&gt; ở mức thành viên-trên-hợp-đồng hay mức hợp đồng?&lt;br&gt;Nếu ở mức hợp đồng thì người vào giữa kỳ không kết luận được.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1610" y="776" width="740" height="152" as="geometry"/></mxCell><mxCell id="15" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-05&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Cây quyền lợi, đầy đủ trong một lần gọi&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /v1/plans/{planCode}/benefits?asOfDate=&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="50" y="944" width="700" height="152" as="geometry"/></mxCell><mxCell id="16" value='&lt;b style="font-size:11px"&gt;Quy tắc adapter&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;children&lt;/span&gt; luôn có ([] ở lá) · &lt;span style="font-family:monospace"&gt;maxCount 0&lt;/span&gt; = không giới hạn ·&lt;br&gt;&lt;span style="font-family:monospace"&gt;coPaymentBp&lt;/span&gt; bắt buộc ở mọi node, "INHERIT" resolve lúc snapshot.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="790" y="944" width="780" height="152" as="geometry"/></mxCell><mxCell id="17" value='&lt;b style="font-size:11px"&gt;Câu hỏi cho phòng Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;C-IMO-14&lt;/b&gt; Endorsement giữa kỳ: sinh &lt;span style="font-family:monospace"&gt;ruleSetRef&lt;/span&gt; mới, hay cùng định danh mà số bên dưới đổi âm thầm?&lt;br&gt;Câu này &lt;b&gt;quyết định hình dạng sổ hạn mức&lt;/b&gt; — không retrofit được.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1610" y="944" width="740" height="152" as="geometry"/></mxCell><mxCell id="18" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-01&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:12px"&gt;Biểu quyền lợi khi ra sản phẩm&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;GET /v1/products/{code}/plans/{plan}/benefits&lt;/span&gt;&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="50" y="1112" width="700" height="152" as="geometry"/></mxCell><mxCell id="19" value='&lt;b style="font-size:11px"&gt;Quy tắc adapter&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Cùng hình dạng với cây quyền lợi của I-05.&lt;br&gt;Kích hoạt &lt;b&gt;thủ công&lt;/b&gt; từ màn hình quản trị khi publish.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="790" y="1112" width="780" height="152" as="geometry"/></mxCell><mxCell id="20" value='&lt;b style="font-size:11px"&gt;Câu hỏi cho phòng Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;X-20&lt;/b&gt; Có API liệt kê rule set không? Nếu có thì chỉ nằm ở đây.&lt;br&gt;I-01 lỗi = hoãn ra sản phẩm; I-05 lỗi = dừng hồ sơ. Hai mức khác nhau.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1610" y="1112" width="740" height="152" as="geometry"/></mxCell><mxCell id="21" value='&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Trong hackathon&lt;/b&gt;: mock seed 12 thành viên, 2 hợp đồng, 3 plan, 51 dòng quyền lợi — cố tình gài một người hết hiệu lực giữa năm và một hợp đồng chưa đóng phí. Chuyển sang hệ thật chỉ đổi Site Setting &lt;span style="font-family:monospace"&gt;InsureMOMode&lt;/span&gt;, chữ ký Server Action giữ nguyên.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="1285" width="2300" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p5" name="06 · Tích hợp Tài chính"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Tích hợp Tài chính — ngoài phạm vi hackathon, cần cho pilot&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Trong hackathon hai giao diện này là &lt;b&gt;stub&lt;/b&gt;: sinh lệnh chi và nhận xác nhận, nhưng không có đồng tiền nào chuyển đi.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="1800" height="66" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;CLM_Core&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Sau khi hồ sơ được duyệt:&lt;br&gt;· chốt số tiền chi trả theo dòng&lt;br&gt;· ghi sổ hạn mức (append-only)&lt;br&gt;· sinh lệnh chi với &lt;span style="font-family:monospace"&gt;instructionRef&lt;/span&gt;&lt;br&gt;&lt;br&gt;Số tiền đã cố định trước khi tới đây —&lt;br&gt;lớp tài chính không được sửa.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#BFD6F2;strokeColor=#4A6F9C;fontColor=#0E2A42;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="420" height="300" as="geometry"/></mxCell><mxCell id="5" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-11&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Lệnh chi&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Gửi: người nhận, số tiền, &lt;span style="font-family:monospace"&gt;instructionRef&lt;/span&gt;, claimNo&lt;br&gt;Nhận: xác nhận đã nhận lệnh + mã tham chiếu bên ngân hàng&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D7EAD4;strokeColor=#6FA463;fontColor=#1F3D1A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="620" height="140" as="geometry"/></mxCell><mxCell id="6" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;I-12&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Xác nhận đã chi&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Callback hoặc poll: lệnh đã thực hiện, ngày giờ, mã giao dịch&lt;br&gt;Ta đóng hồ sơ và thông báo cho khách&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D7EAD4;strokeColor=#6FA463;fontColor=#1F3D1A;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="620" height="140" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:13px"&gt;Phòng Tài chính / Ngân hàng&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Hệ thống thật chưa kết nối.&lt;br&gt;&lt;br&gt;Trong hackathon: mock trả xác nhận ngay,&lt;br&gt;để demo chạy hết vòng đời hồ sơ.&lt;br&gt;&lt;br&gt;Không có tiền thật, không có tài khoản thật,&lt;br&gt;không có số tài khoản nào trong dữ liệu demo.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D7EAD4;strokeColor=#6FA463;fontColor=#1F3D1A;fontSize=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1380" y="130" width="460" height="300" as="geometry"/></mxCell><mxCell id="8" value='&lt;b style="font-size:13px"&gt;Cổng phát hành trước lệnh chi thật đầu tiên — cần phòng Tài chính xác nhận&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;1 · Hợp đồng dữ liệu I-11 / I-12.&lt;/b&gt; Chốt trường người nhận, &lt;span style="font-family:monospace"&gt;instructionRef&lt;/span&gt;, cơ chế callback và cách đối soát khi callback không tới.&lt;br&gt;&lt;b&gt;2 · Quy tắc bảo hiểm y tế.&lt;/b&gt; Phần quỹ BHYT đã thanh toán phải trừ ra trước khi tính phần chi trả của hợp đồng — quy tắc S-17 cần Tài chính xác nhận cách đối soát.&lt;br&gt;&lt;b&gt;3 · Idempotency.&lt;/b&gt; Retry lệnh chi không được sinh hai lần chuyển tiền. Cần khoá nghiệp vụ hoặc &lt;span style="font-family:monospace"&gt;Idempotency-Key&lt;/span&gt; từ phía ngân hàng.&lt;br&gt;&lt;b&gt;4 · Quyền duyệt theo hạn mức.&lt;/b&gt; Trên một ngưỡng số tiền thì cần bao nhiêu người duyệt — quy định nội bộ của Tài chính.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1780" height="150" as="geometry"/></mxCell><mxCell id="9" value='&lt;b style="font-size:13px"&gt;Vì sao để stub trong hackathon&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Phạm vi chấm giải nằm ở &lt;b&gt;thẩm định&lt;/b&gt;, không nằm ở chuyển tiền. Dựng thật đường tiền vừa không cộng điểm, vừa kéo theo rủi ro tuân thủ không cần thiết trong hai ngày.&lt;br&gt;Nhưng giao diện vẫn được định nghĩa và gọi thật qua stub, để khi pilot chỉ phải đổi điểm cuối chứ không phải viết lại luồng — cùng cách làm với InsureMO.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="1780" height="120" as="geometry"/></mxCell><mxCell id="10" value='&lt;b style="font-size:13px"&gt;Nói gì khi họp với Tài chính&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Bốn câu ở ô đỏ là toàn bộ những gì cần từ phòng Tài chính, và &lt;b&gt;không câu nào chặn hackathon&lt;/b&gt; — chúng chặn lần chi trả thật đầu tiên.&lt;br&gt;Đề nghị cụ thể: hẹn một buổi sau hackathon để chốt hợp đồng dữ liệu I-11/I-12 và quy tắc đối soát BHYT, trước khi bàn tới pilot.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="60" y="830" width="1780" height="100" as="geometry"/></mxCell><mxCell id="11" value="sau khi duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#6FA463;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#6FA463;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#6FA463;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="7" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="14" value="đóng hồ sơ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#6FA463;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="6" target="4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="360"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram id="p6" name="07 · Ma trận sở hữu và câu hỏi mở"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:20px"&gt;Ai sở hữu cái gì, và còn vướng ở đâu&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Một trang để trả lời nhanh hai câu hay bị hỏi nhất trong các buổi làm việc: "dữ liệu này của ai" và "còn chờ gì".&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="26" width="2300" height="66" as="geometry"/></mxCell><mxCell id="4" value='&lt;b style="font-size:13px"&gt;Ma trận sở hữu dữ liệu&lt;/b&gt;&lt;table style="font-size:10px;border-collapse:collapse;width:100%;margin-top:4px"&gt;&lt;tr&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Dữ liệu&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Chủ sở hữu&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Ta đọc thế nào&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Sản phẩm, plan, dòng quyền lợi&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;InsureMO&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-01 khi publish, ánh xạ thủ công&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Hợp đồng, kỳ hiệu lực, trạng thái&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;InsureMO&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-05, snapshot lúc đăng ký hồ sơ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Thành viên được bảo hiểm&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;InsureMO&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-05, tìm theo cardNo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Thời gian chờ theo nhóm bệnh&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;InsureMO&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Nằm trong cây quyền lợi I-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Nội dung chứng từ (field, bảng)&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;BnK IDP&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-09, copy một lần vào RawExtractionJson&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Nhận định lâm sàng&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;BnK IDP&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-16, 20 mục văn bản&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Danh mục cơ sở KCB, mã thủ thuật&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;BnK IDP&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;OpenSearch bảng 322 / 316, đồng bộ định kỳ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Hồ sơ bồi thường, trạng thái&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;BnK — ta&lt;/b&gt;&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Entity trong CLM_Core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Sổ hạn mức đã dùng&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;BnK — ta&lt;/b&gt;&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Append-only, ghi khi duyệt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Người thụ hưởng, tài khoản chi trả&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;BnK — ta&lt;/b&gt;&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Entity trong CLM_Core&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Vết agent và vết sửa tay&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;BnK — ta&lt;/b&gt;&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;AgentRun, append-only&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="1140" height="285" as="geometry"/></mxCell><mxCell id="5" value='&lt;b style="font-size:13px"&gt;Trạng thái các giao diện&lt;/b&gt;&lt;table style="font-size:10px;border-collapse:collapse;width:100%;margin-top:4px"&gt;&lt;tr&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Mã&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Nội dung&lt;/th&gt;&lt;th style="text-align:left;padding:2px 5px;border-bottom:1px solid #8A8F88"&gt;Hackathon&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-01&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Biểu quyền lợi theo sản phẩm&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;MOCK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-02 / I-03&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Báo giá, phát hành hợp đồng&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;NGOÀI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-04&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Hợp đồng đã phát hành (webhook/poll)&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;NGOÀI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-05&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Thành viên, hợp đồng, cây quyền lợi&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;MOCK — bắt buộc&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-06&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Gắn claim vào hồ sơ policy&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;NGOÀI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-07&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Nộp chứng từ để bóc tách&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;THẬT&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-08&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Webhook báo bóc tách xong&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;KHÔNG TỒN TẠI → poll&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-09&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Kết quả bóc tách&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;THẬT&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-10&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Ảnh gốc và bounding box&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;thay bằng raw-file + get-ocr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-11 / I-12&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Lệnh chi và xác nhận&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;STUB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-13 / I-14&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Thu phí mock, nạp hợp đồng nhóm&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;NGOÀI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;I-15 / I-16&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;Đánh giá lâm sàng và kết quả&lt;/td&gt;&lt;td style="padding:2px 5px;vertical-align:top;border-bottom:1px solid #D8DBD5"&gt;&lt;b&gt;THẬT&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="1120" height="285" as="geometry"/></mxCell><mxCell id="6" value='&lt;b style="font-size:13px"&gt;Đội BnK IDP · 2 việc CHẶN&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;1.&lt;/b&gt; Trần trang của một block là bao nhiêu, và nâng quota tenant 177 tới 31/10.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Ghim flow &lt;span style="font-family:monospace"&gt;5ed8e4fc&lt;/span&gt; suốt sprint; sửa flow thì bump &lt;span style="font-family:monospace"&gt;workflowId&lt;/span&gt;.&lt;br&gt;&lt;br&gt;Ba việc mức cao: master data trả giá trị giữ chỗ · I-16 cần đánh giá theo dòng ·&lt;br&gt;&lt;span style="font-family:monospace"&gt;warning_level&lt;/span&gt; trộn hai loại ý nghĩa. Bốn việc nhỏ hơn xem trang 04.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="430" width="1140" height="178" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:13px"&gt;Phòng Core / InsureMO · 1 việc chặn thiết kế&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;C-IMO-14&lt;/b&gt; Endorsement giữa kỳ sinh &lt;span style="font-family:monospace"&gt;ruleSetRef&lt;/span&gt; mới, hay cùng định danh mà số&lt;br&gt;bên dưới đổi âm thầm? Câu này quyết định &lt;b&gt;hình dạng sổ hạn mức&lt;/b&gt; và không&lt;br&gt;retrofit được sau.&lt;br&gt;&lt;br&gt;Bốn câu còn lại (X-15, X-16, C-IMO-05, X-20) không chặn hackathon vì đang chạy mock,&lt;br&gt;nhưng cần trước khi chốt mô hình dữ liệu.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FADBD8;strokeColor=#B45450;fontColor=#5A1A18;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="430" width="1140" height="178" as="geometry"/></mxCell><mxCell id="8" value='&lt;b style="font-size:13px"&gt;SA OutSystems · 2 câu, đã có đường lui&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;SA-01&lt;/b&gt; Callable-action list của agent có nhận agent khác không?&lt;br&gt;Nếu không thì AG-0 làm Server Action &lt;span style="font-family:monospace"&gt;OrchestrateClaim&lt;/span&gt; thay vì agent —&lt;br&gt;phương án dự phòng đã thiết kế sẵn, có hàng đợi và Timer.&lt;br&gt;&lt;br&gt;&lt;b&gt;SA-05&lt;/b&gt; Agent xử lý việc chạy lâu và retry trong một lượt tool thế nào?&lt;br&gt;Ảnh hưởng chuyện poll IDP nằm ở Timer hay trong lượt agent.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="626" width="1140" height="178" as="geometry"/></mxCell><mxCell id="9" value='&lt;b style="font-size:13px"&gt;Phòng Tài chính · sau hackathon&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Chốt hợp đồng dữ liệu I-11/I-12, quy tắc đối soát phần quỹ BHYT đã thanh toán,&lt;br&gt;cơ chế chống chi trùng khi retry, và quyền duyệt theo hạn mức số tiền.&lt;br&gt;&lt;br&gt;Không câu nào chặn hackathon — chúng chặn lần chi trả thật đầu tiên.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1230" y="626" width="1140" height="178" as="geometry"/></mxCell><mxCell id="10" value='&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Tổng kết cho người ra quyết định:&lt;/b&gt; ba việc chặn — hai của đội IDP (quota, ghim flow), một của phòng Core (hình dạng endorsement). Mọi thứ còn lại đều đã có đường đi hoặc đường lui.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#DDEBE2;strokeColor=#4F8E6C;fontColor=#14361F;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="836" width="2300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p7" name="08 · Kiến trúc tích hợp — chuẩn OutSystems"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3" value='&lt;b style="font-size:21px"&gt;Agentic Health Claim Adjudication — Integration Architecture&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Dựng theo &lt;b&gt;OutSystems Architecture Canvas&lt;/b&gt;: End-User → Core → Foundation, phụ thuộc chỉ đi một chiều từ trên xuống.   |   ODC (OutSystems Developer Cloud) + AI Agent Workbench   |   17/09/2026&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="2460" height="70" as="geometry"/></mxCell><mxCell id="4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#152439;strokeColor=#0B1526;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="118" width="1520" height="1180" as="geometry"/></mxCell><mxCell id="5" value='&lt;b style="font-size:11px"&gt;LOGO&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;OutSystems&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#9AA096;fontColor=#7A8078;fontSize=11;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="78" y="142" width="190" height="66" as="geometry"/></mxCell><mxCell id="6" value='&lt;b style="font-size:17px"&gt;OutSystems Developer Cloud (ODC)&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Nền tảng chạy toàn bộ ứng dụng bồi thường — BnK sở hữu và phát triển&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#E6ECF5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="286" y="142" width="700" height="66" as="geometry"/></mxCell><mxCell id="7" value='&lt;b style="font-size:12.5px"&gt;1 ODC app  ·  5 module  ·  6 AI agent&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#C1003C;strokeColor=#8E002C;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="404" height="50" as="geometry"/></mxCell><mxCell id="8" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;LAYER 1&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;END-USER  ·  giao diện người dùng&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Chỉ chứa màn hình và điều hướng. Không logic nghiệp vụ, không gọi thẳng hệ ngoài.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#CFE4F7;strokeColor=#2F7FD1;fontColor=#0F3357;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="232" width="1464" height="196" as="geometry"/></mxCell><mxCell id="9" value='&lt;b style="font-size:13px"&gt;CLM_Portal&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Reactive Web · khách hàng&lt;br&gt;Nộp hồ sơ · tải chứng từ · theo dõi · bổ sung&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EAF4FD;strokeColor=#2F7FD1;fontColor=#0F3357;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="104" y="300" width="452" height="108" as="geometry"/></mxCell><mxCell id="10" value='&lt;b style="font-size:13px"&gt;CLM_Console&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Reactive Web · nhân viên thẩm định&lt;br&gt;Hàng đợi · đối chiếu ảnh ↔ số · duyệt · nhật ký agent&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EAF4FD;strokeColor=#2F7FD1;fontColor=#0F3357;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="578" y="300" width="452" height="108" as="geometry"/></mxCell><mxCell id="11" value='&lt;b style="font-size:13px"&gt;Màn hình quản trị&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Ánh xạ biểu quyền lợi · nạp hợp đồng nhóm&lt;br&gt;Cấu hình template và bộ chứng từ&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EAF4FD;strokeColor=#2F7FD1;fontColor=#0F3357;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1052" y="300" width="466" height="108" as="geometry"/></mxCell><mxCell id="12" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;LAYER 2&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;CORE  ·  nghiệp vụ và phán đoán&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Khái niệm nghiệp vụ tái dùng được. Tiền chỉ được tính ở đây.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBE4C4;strokeColor=#D9902C;fontColor=#573606;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="452" width="1464" height="236" as="geometry"/></mxCell><mxCell id="13" value='&lt;b style="font-size:13px"&gt;CLM_Core&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;34 Server Action tất định — không có LLM.&lt;/b&gt;&lt;br&gt;· Chuỗi 13 bước tính tiền theo từng dòng chi phí&lt;br&gt;· Snapshot quyền lợi tại ngày dịch vụ rồi đóng băng (P-02)&lt;br&gt;· Sổ hạn mức append-only: năm · đợt · ngày · đồng chi trả&lt;br&gt;· Máy trạng thái hồ sơ và quyền duyệt&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FEF4E6;strokeColor=#D9902C;fontColor=#573606;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="104" y="520" width="700" height="156" as="geometry"/></mxCell><mxCell id="14" value='&lt;b style="font-size:13px"&gt;CLM_Agents  ·  AI Agent Workbench&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;6 agent · 39 tool binding · 13 hand-off.&lt;/b&gt; Agent đọc và đề xuất, không ghi tiền.&lt;br&gt;AG-0 Điều phối · AG-1 Tiếp nhận · AG-2 Đối chiếu&lt;br&gt;AG-3 Lâm sàng · AG-4 Danh mục · AG-5 Soạn thảo&lt;br&gt;Tool của agent là Server Action của CLM_Core — không gọi thẳng REST ra ngoài.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FEF4E6;strokeColor=#D9902C;fontColor=#573606;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="826" y="520" width="692" height="156" as="geometry"/></mxCell><mxCell id="15" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;LAYER 3&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;FOUNDATION  ·  tích hợp và tiện ích&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;Bọc hệ ngoài. Không biết gì về nghiệp vụ bồi thường — chỉ dịch định dạng và chịu lỗi.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D3EBDA;strokeColor=#3F8C55;fontColor=#12331E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="712" width="1464" height="246" as="geometry"/></mxCell><mxCell id="16" value='&lt;b style="font-size:13px"&gt;CLM_IDP_Int&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;REST Consume → BnK IDP&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpSession&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;IdpSubmitPackage&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpPoller&lt;/span&gt; (Timer) · &lt;span style="font-family:monospace"&gt;IdpGetExtractionResult&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;IdpStartClinicalAssessment&lt;/span&gt;&lt;br&gt;&lt;br&gt;Hấp thụ 13 bẫy đã ghi lại của IDP&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EDF8F0;strokeColor=#3F8C55;fontColor=#12331E;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="104" y="780" width="462" height="166" as="geometry"/></mxCell><mxCell id="17" value='&lt;b style="font-size:13px"&gt;CLM_IMO_Int&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;REST Consume → InsureMO&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;SearchMembers&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;GetPolicy&lt;/span&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;GetMemberCoverage&lt;/span&gt; · &lt;span style="font-family:monospace"&gt;GetBenefitTree&lt;/span&gt;&lt;br&gt;&lt;br&gt;Hackathon: đọc seed trong ODC.&lt;br&gt;Đổi sang thật bằng Site Setting &lt;span style="font-family:monospace"&gt;InsureMOMode&lt;/span&gt;.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EDF8F0;strokeColor=#3F8C55;fontColor=#12331E;fontSize=9.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="586" y="780" width="462" height="166" as="geometry"/></mxCell><mxCell id="18" value='&lt;b style="font-size:13px"&gt;CLM_Fin_Int&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;REST Consume → Tài chính&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;CreatePaymentInstruction&lt;/span&gt; (I-11)&lt;br&gt;&lt;span style="font-family:monospace"&gt;ConfirmPaymentSettled&lt;/span&gt; (I-12)&lt;br&gt;&lt;br&gt;Stub trong hackathon — sinh lệnh,&lt;br&gt;không chuyển tiền.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#EDF8F0;strokeColor=#3F8C55;fontColor=#12331E;fontSize=9.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1068" y="780" width="450" height="166" as="geometry"/></mxCell><mxCell id="19" value='&lt;span style="font-size:9px;letter-spacing:.5px;opacity:.75"&gt;ODC PLATFORM SERVICES&lt;/span&gt;&lt;br&gt;&lt;b style="font-size:13px"&gt;Dịch vụ nền tảng — dùng sẵn, không phải tự dựng&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#1D3150;strokeColor=#0B1526;fontColor=#E6ECF5;fontSize=10;" vertex="1" parent="1"><mxGeometry x="78" y="982" width="1464" height="200" as="geometry"/></mxCell><mxCell id="20" value='&lt;b style="font-size:12px"&gt;Identity&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Đăng nhập nhân viên và khách hàng,&lt;br&gt;vai và quyền theo màn hình&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#27415F;strokeColor=#3C5A7C;fontColor=#E6ECF5;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="104" y="1048" width="268" height="112" as="geometry"/></mxCell><mxCell id="21" value='&lt;b style="font-size:12px"&gt;Secrets&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Tài khoản IDP, khoá InsureMO&lt;br&gt;nằm trong ODC Secret — không vào source&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#27415F;strokeColor=#3C5A7C;fontColor=#E6ECF5;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="392" y="1048" width="268" height="112" as="geometry"/></mxCell><mxCell id="22" value='&lt;b style="font-size:12px"&gt;Logging &amp;amp; Traces&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Vết mọi lời gọi REST ra ngoài,&lt;br&gt;thời gian đáp, mã lỗi&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#27415F;strokeColor=#3C5A7C;fontColor=#E6ECF5;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="680" y="1048" width="268" height="112" as="geometry"/></mxCell><mxCell id="23" value='&lt;b style="font-size:12px"&gt;Timers&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;IdpPoller, đồng bộ master data,&lt;br&gt;cảnh báo quota theo ngày&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#27415F;strokeColor=#3C5A7C;fontColor=#E6ECF5;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="968" y="1048" width="268" height="112" as="geometry"/></mxCell><mxCell id="24" value='&lt;b style="font-size:12px"&gt;Data&lt;/b&gt;&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;Entity của CLM_Core:&lt;br&gt;hồ sơ, sổ hạn mức, vết agent&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#27415F;strokeColor=#3C5A7C;fontColor=#E6ECF5;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1256" y="1048" width="268" height="112" as="geometry"/></mxCell><mxCell id="25" value='&lt;b style="font-size:13px"&gt;Quy tắc phụ thuộc của Architecture Canvas&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Mũi tên chỉ đi &lt;b&gt;xuống&lt;/b&gt;: End-User gọi Core, Core gọi Foundation. Không có chiều ngược lại, không có gọi ngang giữa hai module cùng lớp.&lt;br&gt;Nhờ vậy đổi một hệ ngoài chỉ phải sửa một module ở Layer 3, không lan lên trên.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#E6ECF5;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="78" y="1206" width="1464" height="72" as="geometry"/></mxCell><mxCell id="26" value='&lt;b style="font-size:13px"&gt;HỆ THỐNG NGOÀI  ·  REST / JSON over HTTPS&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FBFBF9;strokeColor=#8A8F88;fontColor=#2A2E2A;fontSize=11;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1700" y="118" width="800" height="1180" as="geometry"/></mxCell><mxCell id="27" value='&lt;b style="font-size:11px"&gt;LOGO&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;BnK IDP&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#9AA096;fontColor=#7A8078;fontSize=11;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1732" y="180" width="150" height="60" as="geometry"/></mxCell><mxCell id="28" value='&lt;b style="font-size:17px"&gt;BnK IDP&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Bóc tách chứng từ và đánh giá lâm sàng&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1898" y="180" width="562" height="60" as="geometry"/></mxCell><mxCell id="29" value='&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;span style="font-family:monospace"&gt;idp-api.idpstg.bnksolution.com&lt;/span&gt; · tenant 177 · partner 40&lt;br&gt;&lt;b&gt;Xác thực:&lt;/b&gt; JWT bearer, không refresh token · header &lt;span style="font-family:monospace"&gt;User-Agent&lt;/span&gt; bắt buộc&lt;br&gt;&lt;br&gt;&lt;b&gt;Bóc tách&lt;/b&gt; &lt;span style="font-family:monospace"&gt;POST /request&lt;/span&gt; → poll → &lt;span style="font-family:monospace"&gt;GET /request/{id}/result&lt;/span&gt;&lt;br&gt;   9 template Claim MVP (6090–6098), bộ chứng từ 198&lt;br&gt;   Đo thật: 1 trang ≈ 15 s · 9 trang song song ≈ 65 s · &lt;b&gt;9/9 phân loại đúng&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Đánh giá lâm sàng&lt;/b&gt; flow Langflow &lt;span style="font-family:monospace"&gt;5ed8e4fc&lt;/span&gt;&lt;br&gt;   &lt;span style="font-family:monospace"&gt;PUT /workflow/request&lt;/span&gt; → kích hoạt → poll → &lt;span style="font-family:monospace"&gt;/result/json&lt;/span&gt;&lt;br&gt;   Đo thật: 9 chứng từ ≈ 118 s · 20 mục cảnh báo và trích field&lt;br&gt;&lt;br&gt;&lt;b&gt;Danh mục&lt;/b&gt; OpenSearch bảng 322 (13.328 cơ sở KCB) · 321 · 316&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#E4D6EA;strokeColor=#8C6BA0;fontColor=#3D2A47;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1732" y="252" width="728" height="288" as="geometry"/></mxCell><mxCell id="30" value='&lt;b style="font-size:11px"&gt;LOGO&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;InsureMO&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#9AA096;fontColor=#7A8078;fontSize=11;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1732" y="570" width="150" height="60" as="geometry"/></mxCell><mxCell id="31" value='&lt;b style="font-size:17px"&gt;InsureMO&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Hệ quản lý sản phẩm và hợp đồng bảo hiểm&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1898" y="570" width="562" height="60" as="geometry"/></mxCell><mxCell id="32" value='&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Hackathon: MOCK&lt;/b&gt; — seed trong ODC, chữ ký Server Action giữ nguyên khi đổi sang thật.&lt;br&gt;&lt;br&gt;&lt;span style="font-family:monospace"&gt;GET /v1/members&lt;/span&gt; tìm thành viên được bảo hiểm&lt;br&gt;&lt;span style="font-family:monospace"&gt;GET /v1/policies/{policyNo}&lt;/span&gt; chi tiết hợp đồng&lt;br&gt;&lt;span style="font-family:monospace"&gt;GET /v1/members/{id}/coverage?asOfDate=&lt;/span&gt; coverage tại ngày dịch vụ&lt;br&gt;&lt;span style="font-family:monospace"&gt;GET /v1/plans/{planCode}/benefits?asOfDate=&lt;/span&gt; cây quyền lợi&lt;br&gt;&lt;br&gt;Đường dẫn trên là &lt;b&gt;facade của adapter&lt;/b&gt; — schema thật của vendor chưa ai thấy.&lt;br&gt;Ranh giới: hợp đồng thuộc InsureMO, bồi thường thuộc ta.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFE3C6;strokeColor=#D08A1E;fontColor=#5A3703;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1732" y="642" width="728" height="230" as="geometry"/></mxCell><mxCell id="33" value='&lt;b style="font-size:11px"&gt;LOGO&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Ngân hàng&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#9AA096;fontColor=#7A8078;fontSize=11;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1732" y="902" width="150" height="60" as="geometry"/></mxCell><mxCell id="34" value='&lt;b style="font-size:17px"&gt;Tài chính / Ngân hàng&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.35;margin-top:3px"&gt;Lệnh chi và xác nhận đã chi&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1898" y="902" width="562" height="60" as="geometry"/></mxCell><mxCell id="35" value='&lt;div style="font-size:9.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Hackathon: STUB&lt;/b&gt; — sinh lệnh chi, nhận xác nhận giả lập, không có tiền thật.&lt;br&gt;&lt;br&gt;I-11 lệnh chi: người nhận, số tiền, &lt;span style="font-family:monospace"&gt;instructionRef&lt;/span&gt;, claimNo&lt;br&gt;I-12 xác nhận đã chi: ngày giờ, mã giao dịch → ta đóng hồ sơ&lt;br&gt;&lt;br&gt;Cổng phát hành trước lệnh chi thật đầu tiên còn chờ phòng Tài chính.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#D7EAD4;strokeColor=#6FA463;fontColor=#1F3D1A;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="1732" y="974" width="728" height="152" as="geometry"/></mxCell><mxCell id="36" value='&lt;b style="font-size:13px"&gt;Ba trạng thái tích hợp trên trang này&lt;/b&gt;&lt;div style="font-size:10px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;THẬT&lt;/b&gt; — BnK IDP: đã gọi thật trên staging, mọi con số ở trên là đo được.&lt;br&gt;&lt;b&gt;MOCK&lt;/b&gt; — InsureMO: hợp đồng dữ liệu do ta định nghĩa, dữ liệu từ seed trong ODC.&lt;br&gt;&lt;b&gt;STUB&lt;/b&gt; — Tài chính: giao diện có thật, hành vi giả lập, không có giao dịch nào.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFF4D4;strokeColor=#C9A73F;fontColor=#4A3A06;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1732" y="1150" width="728" height="128" as="geometry"/></mxCell><mxCell id="37" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1566" y="394" width="5" height="5" as="geometry"/></mxCell><mxCell id="38" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1566" y="755" width="5" height="5" as="geometry"/></mxCell><mxCell id="39" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=none;strokeColor=none;fontColor=#2A2E2A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1566" y="1048" width="5" height="5" as="geometry"/></mxCell><mxCell id="40" value='&lt;b style="font-size:13px"&gt;Ô "LOGO" là chỗ đặt logo thật&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;Bốn ô nét đứt ghi LOGO giữ đúng kích thước để anh thả file logo vào trong draw.io (kéo ảnh vào ô, hoặc Edit Style → &lt;span style="font-family:monospace"&gt;shape=image;image=…&lt;/span&gt;).&lt;br&gt;Tôi không vẽ sẵn logo vì đó là nhãn hiệu của OutSystems, InsureMO và ngân hàng — lấy từ bộ nhận diện chính thức của mỗi bên sẽ đúng phiên bản và đúng tỷ lệ.&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="1320" width="2460" height="100" as="geometry"/></mxCell><mxCell id="41" value='&lt;b style="font-size:13px"&gt;Màu theo quy ước Architecture Canvas của OutSystems&lt;/b&gt;&lt;div style="font-size:10.5px;line-height:1.35;margin-top:3px"&gt;&lt;b&gt;Xanh dương&lt;/b&gt; = End-User (màn hình)   ·   &lt;b&gt;Vàng cam&lt;/b&gt; = Core (khái niệm nghiệp vụ tái dùng được)   ·   &lt;b&gt;Xanh lá&lt;/b&gt; = Foundation (bọc hệ ngoài và tiện ích kỹ thuật)&lt;br&gt;&lt;b&gt;Xanh đậm&lt;/b&gt; = dịch vụ nền tảng ODC dùng sẵn   ·   &lt;b&gt;Nét đứt&lt;/b&gt; = chưa phải hệ thật trong hackathon (mock hoặc stub)&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=5;spacingBottom=5;fillColor=#FFFFFF;strokeColor=#A8ACA6;fontColor=#222621;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="50" y="1440" width="2460" height="96" as="geometry"/></mxCell><mxCell id="42" value="REST / JSON&#10;JWT bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#8C6BA0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="37" target="29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="43" value="REST / JSON&#10;mock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#D08A1E;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="38" target="32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="44" value="REST / JSON&#10;stub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#6FA463;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="39" target="35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="10" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="454" y="440"/></Array></mxGeometry></mxCell><mxCell id="46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="9" target="13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="440"/><mxPoint x="220" y="496"/></Array></mxGeometry></mxCell><mxCell id="47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="13" target="17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="700"/><mxPoint x="817" y="700"/></Array></mxGeometry></mxCell><mxCell id="49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#5B82B0;fontSize=10;fontColor=#222621;labelBackgroundColor=#FFFFFF;jettySize=12;" edge="1" parent="1" source="13" target="18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="712"/><mxPoint x="1293" y="712"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram>
