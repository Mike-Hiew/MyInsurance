        <mxCell id="7WkLI7WnepzjTEarRiFn-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b style=&quot;font-size:12px&quot;&gt;Chú giải&lt;/b&gt;&lt;div style=&quot;font-size:10px;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#d79b00&quot;&gt;&lt;b&gt;━━ cam&lt;/b&gt;&lt;/span&gt; agent gọi tool (không bao giờ ghi)&lt;br&gt;&lt;span style=&quot;color:#0d6a63&quot;&gt;&lt;b&gt;━━ xanh&lt;/b&gt;&lt;/span&gt; đường tới tiền thật (I-11/I-12)&lt;br&gt;&lt;span style=&quot;color:#9673a6&quot;&gt;&lt;b&gt;━━ tím&lt;/b&gt;&lt;/span&gt; cắt qua ranh giới hệ thống&lt;br&gt;&lt;b&gt;━━ đen&lt;/b&gt; dữ liệu tất định trong tenant&lt;br&gt;&lt;b&gt;- - -&lt;/b&gt; mock / stub / callback&lt;br&gt;&lt;br&gt;Trang 2: chi tiết InsureMO · Trang 3: chi tiết BnK IDP · Trang 4: luồng gọi IDP theo thời gian&lt;/div&gt;" vertex="1">
