        <mxCell id="5128-40" value="Kiểu hỏng khác nhau, xử lý khác nhau: lỗi IDP → EXTRACTION_ERROR, hỏi lại khách, KHÔNG BAO GIỜ thành từ chối. Kiểm tra y khoa hỏng/PARTIAL → chạy Track 1 một mình, trần 15 phút." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDEFEA;strokeColor=#B4472F;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="960" width="1560" height="60" as="geometry"/></mxCell>
