        <mxCell id="3746-29" value="Các bước 3, 7, 9, 12, 13 của chuỗi không phát sinh thay đổi trên hồ sơ ví dụ này." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#5B6B70;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="798" width="760" height="20" as="geometry"/></mxCell>
        <mxCell id="3746-30" value="Cổng tự động duyệt — cả bốn điều kiện phải đúng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF6E3;strokeColor=#B8860B;dashed=0;fontColor=#0B4F53;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="560" height="400" as="geometry"/></mxCell>
        <mxCell id="3746-31" value="1 · Số tiền ≤ ngưỡng (2.000.000 ₫ — là tham số, không hard-code) VÀ không dòng nào bị cắt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8860B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="520" height="72" as="geometry"/></mxCell>
