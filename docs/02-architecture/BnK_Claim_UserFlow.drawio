        <mxCell id="8036-13" value="Đọc chứng từ &amp; chi phí Ảnh gốc nằm cạnh dữ liệu đã đọc; sửa tại chỗ nếu máy đọc sai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0E7C7B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
