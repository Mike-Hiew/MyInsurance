        <mxCell id="8036-17" value="Đọc chứng từ, đối chiếu chéo, kiểm tra phạm vi và tính số tiền — trước khi cán bộ mở hồ sơ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF4F1;strokeColor=#0E7C7B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
