        </mxCell>
        <mxCell id="8036-14" value="Xem đề xuất của hệ thống Mỗi đề xuất kèm căn cứ. Xác nhận hoặc bác bỏ — bác bỏ phải ghi lý do" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8860B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1140" y="150" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="8036-15" value="Kiểm phương án bồi thường Số tiền, hạn mức còn lại, checklist trước khi gửi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0E7C7B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
