        <mxCell id="8036-11" value="Mở hàng đợi công việc Lọc theo trạng thái, tuổi hồ sơ; nhận hồ sơ chưa giao" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0E7C7B;fontColor=#1F2A2E;fontSize=11;verticalAlign=middle;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
